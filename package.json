{
  "name": "tsray",
  "version": "0.1.0",
  "description": "Semantic TypeScript/React indexer, MCP server, and offline architecture reporter",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "tsray": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "web/dist/report.html",
    ".opencode/skills/tsray/SKILL.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "build:web": "npm --prefix web run build && node scripts/embed-report.mjs",
    "build:bin": "bun build ./src/cli/index.ts --compile --outfile ./bin/tsray",
    "dev": "node --watch dist/cli/index.js serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "install:mcp": "node dist/cli/index.js install-mcp",
    "uninstall:mcp": "node dist/cli/index.js uninstall-mcp",
    "mcp:status": "node dist/cli/index.js mcp-status",
    "install:skill": "node dist/cli/index.js install-skill",
    "uninstall:skill": "node dist/cli/index.js uninstall-skill",
    "skill:status": "node dist/cli/index.js skill-status",
    "install:all": "npm run build && npm link && npm run install:skill && npm run install:mcp",
    "uninstall:all": "npm run uninstall:mcp && npm run uninstall:skill && npm uninstall --global tsray",
    "prepublishOnly": "npm run verify && npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chokidar": "^4.0.3",
    "smol-toml": "^1.9.1",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.0",
    "eslint": "^10.15.0",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
